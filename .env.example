# AeroVector Environment Configuration

# Server Port
PORT=3000

# AirLabs Aviation API (Optional for verified commercial flight schedules - 1,000 free calls/month)
# Obtain your free API key at: https://airlabs.co
AIRLABS_API_KEY=your_airlabs_api_key_here

# OpenSky Network API Credentials (Optional - Authenticated OAuth2 for high-rate live ADS-B streams)
# Obtain free credentials at: https://opensky-network.org
OPENSKY_CLIENT_ID=your_opensky_client_id
OPENSKY_CLIENT_SECRET=your_opensky_client_secret
